# Example Environment Configuration Template for Orbit 360 CRM
# Copy this file to .env.local and update with your actual credentials

# MongoDB Database Connection String
MONGODB_URI=mongodb://127.0.0.1:27017/orbit360_crm

# JWT Authentication Secrets
JWT_SECRET=orbit360_super_secret_jwt_key_2026
JWT_REFRESH_SECRET=orbit360_super_secret_refresh_key_2026
